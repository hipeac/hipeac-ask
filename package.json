    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
